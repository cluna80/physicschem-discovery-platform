@app.route('/quantum_lab')
def quantum_lab():
    """Virtual Quantum Lab - Grover's algorithm simulator"""
    return render_template('quantum_lab.html')

@app.route('/api/run_quantum', methods=['POST'])
def run_quantum():
    """Run Grover's algorithm simulation"""
    data = request.json
    n_qubits = int(data.get('n_qubits', 3))
    target = int(data.get('target', 5))
    noise = float(data.get('noise', 0))
    iterations = int(data.get('iterations', 0))
    
    # Calculate theoretical success based on scaling study
    if n_qubits <= 4:
        base_success = 94.5
    elif n_qubits <= 10:
        base_success = 81.3
    elif n_qubits <= 15:
        base_success = 64.6
    elif n_qubits <= 20:
        base_success = 3.7
    elif n_qubits <= 25:
        base_success = 0.12
    else:
        base_success = 0.0038
    
    # Apply noise effect
    success = base_success - noise * 200
    success = max(0, min(100, success))
    
    # If iterations specified, adjust
    if iterations > 0:
        optimal_iters = int(np.pi / 4 * np.sqrt(2**n_qubits))
        if iterations == optimal_iters:
            success = base_success
        elif iterations < optimal_iters:
            success = success * (iterations / optimal_iters)
        else:
            # Overshoot reduces probability
            success = success * (1 - (iterations - optimal_iters) / optimal_iters * 0.8)
    
    return jsonify({
        'n_qubits': n_qubits,
        'target': target,
        'noise': round(noise * 100, 1),
        'iterations': iterations,
        'success_probability': round(success, 2),
        'optimal_iterations': int(np.pi / 4 * np.sqrt(2**n_qubits))
    })

