class GrowingAgent:
    """
    Grows fragment hits into lead-sized molecules using:
    1. R-group enumeration (systematic)
    2. Scaffold merging (combine two fragments)
    3. Linker insertion (add spacer between fragment and pharmacophore)
    """

    # R-groups to enumerate at reactive positions
    RGROUPS = {
        "alkyl":    ["C","CC","CCC","CCCC","CCCCC","CC(C)C","CCC(C)C"],
        "safe_heads":["c1ccccc1","c1cccc(F)c1","c1ccc(F)cc1","c1ccc(O)cc1","c1cccc(N)c1","c1ccc(N)cc1"],
        "fluorine": ["F","C(F)(F)F","CF3","FC(F)F"],
        "halogens": ["Cl","Br"],
        "amines":   ["N","NC","NCC","NCCC","N(C)C"],
        "ethers":   ["OC","OCC","OCCC","OC(C)C"],
        "aromatics":["c1ccccc1","c1ccncc1","c1ccc(F)cc1","c1ccc(Cl)cc1"],
        "cycles":   ["C1CCNCC1","C1CCOC1","C1CCOCC1","C1CCCC1"],
        "linkers":  ["CC","CCC","CCCC","CCO","CCN","CCNC"],
    }

    # Pharmacophore tails (target-specific binding groups)
    PHARMA_TAILS = {
        "EGFR":  [
            "Nc1ncnc2ccccc12",           # quinazoline head
            "Nc1ccc(Nc2ncnc3ccccc23)cc1",# anilinoquinazoline
            "c1ccc2[nH]cnc2c1",          # azaindole
        ],
        "HIV":   [
            "NS(=O)(=O)c1ccccc1",        # sulfonamide
            "C1CC2CCOC2O1",              # bis-THF
            "OC(Cc1ccccc1)C(=O)N",      # Phe-ol
        ],
        "T790M": [
            "Nc1ncnc2ccccc12",
            "c1ccc2[nH]cnc2c1",
        ],
        "HIV_DIP": [
            # Halobenzyl tails (Dolutegravir / Bictegravir INSTI class)
            "Cc1ccc(F)cc1F",
            "Cc1cc(F)cc(F)c1",
            "OCC(O)Cc1cc(F)cc(F)c1",
            "NCC(O)Cc1cc(F)cc(F)c1",
            # Naphthyridine carboxamide (Raltegravir class)
            "c1cnc2ccccc2c1C(=O)N",
            "c1ccc2ncccc2c1C(=O)O",
            # Oxadiazole / triazole INSTI warheads
            "c1nnco1",
            "c1nncn1C",
            "CC1=CC(=O)N(Cc2ccccc2)N1",
            # Carbamoyl pyridone (Bictegravir core extension)
            "O=C1CC(=O)c2ccc(F)cc2N1",
            "O=C1CC(=O)c2cc(F)ccc2N1",
            # Diketo extension tails (chelator + halobenzyl)
            "O=C(O)C(=O)Cc1cc(F)cc(F)c1",
            "O=C(O)C(=O)Cc1ccc(F)c(F)c1",
        ],
    }

    def __init__(self, logger: AgentLogger, docking_agent: DockingAgent,
                 target: str = "EGFR"):
        self.log    = logger
        self.dock   = docking_agent
        self.target = target
        self.grown  = []

    def _attach_rgroup(self, base_smi: str, rgroup: str) -> list:
        """Attach an R-group to each attachment point of base fragment."""
        if not RDKIT_OK: return []
        candidates = []
        # Simple concatenation strategies
        strategies = [
            f"{base_smi}{rgroup}",        # direct append
            f"{rgroup}{base_smi}",        # prepend
            f"{base_smi}C{rgroup}",       # methylene spacer
            f"{base_smi}CC{rgroup}",      # ethylene spacer
        ]
        for smi in strategies:
            try:
                with _SilenceRDKit():
                    mol = Chem.MolFromSmiles(smi)
                if mol:
                    csmi = Chem.MolToSmiles(mol)
                    mw = Descriptors.MolWt(mol)
                    if 150 <= mw <= 500 and csmi not in [c["smiles"] for c in candidates]:
                        candidates.append({"smiles": csmi, "MW": round(mw,1)})
            except Exception:
                pass
        return candidates

    def _merge_fragments(self, frag1: str, frag2: str) -> list:
        """Merge two fragments with various linkers."""
        if not RDKIT_OK: return []
        linkers = ["","C","CC","CCC","N","NC","O","OC"]
        results = []
        for l in linkers:
            smi = f"{frag1}{l}{frag2}"
            try:
                with _SilenceRDKit():
                    mol = Chem.MolFromSmiles(smi)
                if mol:
                    csmi = Chem.MolToSmiles(mol)
                    mw   = Descriptors.MolWt(mol)
                    logp = Descriptors.MolLogP(mol)
                    if 200 <= mw <= 500 and logp <= 6:
                        results.append({
                            "smiles": csmi,
                            "MW": round(mw,1),
                            "LogP": round(logp,2)
                        })
            except Exception:
                pass
        return results

    def grow(self, top_frags: list, n_per_frag: int = 10,
             ref_affinity: float = -7.5) -> list:
        """
        Grow top fragments into lead candidates.
        Returns all grown compounds that beat affinity threshold.
        """
        self.log.log("GrowingAgent",
            f"Growing {len(top_frags)} fragment hits -> target leads...")
        self.log.log("GrowingAgent",
            f"Strategy: R-group + pharmacophore tail attachment")

        all_candidates = []
        tails = self.PHARMA_TAILS.get(self.target, [])

        for frag in top_frags:
            base = frag["smiles"]
            fid  = frag["id"]
            self.log.log("GrowingAgent",
                f"  Growing {fid} ({frag['name']}) - "
                f"base affinity {frag.get('dock_affinity','?'):.2f} kcal/mol")

            candidates = []

            # Strategy 1: Attach pharmacophore tails
            for tail in tails:
                grown = self._merge_fragments(base, tail)
                candidates.extend(grown)

            # Strategy 2: R-group enumeration
            for rg_class, rgroups in self.RGROUPS.items():
                for rg in rgroups[:2]:  # limit per class
                    grown = self._attach_rgroup(base, rg)
                    candidates.extend(grown[:3])

            # Strategy 3: Merge with another top fragment
            if len(top_frags) > 1:
                partner = random.choice([f for f in top_frags if f != frag])
                merged  = self._merge_fragments(base, partner["smiles"])
                candidates.extend(merged)

            # Deduplicate
            seen = set()
            unique = []
            for c in candidates:
                if c["smiles"] not in seen:
                    seen.add(c["smiles"])
                    unique.append(c)

            self.log.log("GrowingAgent",
                f"    Generated {len(unique)} candidates -> docking top {n_per_frag}...")

            # Dock all, keep best
            docked = []
            for i, cand in enumerate(unique[:n_per_frag*4]):
                cid = f"{fid}_G{i+1:03d}"
                r   = self.dock.dock(cand["smiles"], cid)
                aff = r.get("affinity")
                if aff is not None:
                    cand.update({
                        "id": cid, "parent": fid,
                        "dock_affinity": aff,
                        "dock_poses": r.get("n_poses",0),
                    })
                    docked.append(cand)

            docked.sort(key=lambda x: x.get("dock_affinity", 0))
            hits = [d for d in docked if d.get("dock_affinity",0) <= ref_affinity]

            for h in hits[:n_per_frag]:
                self.log.log("GrowingAgent",
                    f"    * {h['id']:<12} {h['dock_affinity']:>7.2f} kcal/mol  "
                    f"MW={h.get('MW','?')}  LogP={h.get('LogP','?')}")
            all_candidates.extend(docked[:n_per_frag])

        self.grown = sorted(all_candidates,
                            key=lambda x: x.get("dock_affinity",0))
        self.log.log("GrowingAgent",
            f"Growth cycle complete: {len(self.grown)} compounds produced")
        return self.grown

