class _SilenceRDKit:
    """Suppress RDKit C-level stderr (kekulization noise etc)."""
    def __enter__(self):
        self._devnull = open(_os.devnull,'w')
        self._old = _os.dup(2)
        _os.dup2(self._devnull.fileno(), 2)
        return self
    def __exit__(self,*a):
        _os.dup2(self._old, 2)
        _os.close(self._old)
        self._devnull.close()

